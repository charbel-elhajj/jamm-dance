---
import BaseLayout from '../layouts/BaseLayout.astro';
import UpcomingEventsSection from '../components/UpcomingEventsSection.astro';

const danceStyles = [
  {
    name: 'Salsa',
    image: '/assets/danse-types/Salsa cubaine.png',
    description:
      "Laissez-vous porter par les rythmes cubains avec la Salsa, une danse festive, chaleureuse et accessible à tous !",
  },
  {
    name: 'Bachata',
    image: '/assets/danse-types/Bachata.png',
    description:
      "La Bachata est une danse chaleureuse et accessible qui allie douceur, musicalité et connexion entre partenaires.",
  },
  {
    name: 'Belly Modern',
    image: '/assets/danse-types/Belly Modern.png',
    description:
      "Une discipline unique qui fusionne la street dance et la danse orientale, sur des rythmes hip hop et électro aux influences orientales, alliant puissance, fluidité et féminité.",
  },
  {
    name: 'Danse Orientale',
    image: '/assets/danse-types/Danse orientale.png',
    description:
      "La danse orientale met en valeur la féminité, la musicalité et la précision des mouvements grâce à des chorégraphies sur des rythmes envoûtants.",
  },
  {
    name: 'Zumba\u2122',
    image: '/assets/danse-types/Zumba.png',
    description:
      "Faites le plein d'énergie avec la Zumba, un mélange de danse, de fitness et de bonne humeur !",
  },
  {
    name: "Latin'Ladies",
    image: '/assets/danse-types/Latin Ladies.png',
    description:
      "Affirmez votre style et votre féminité avec le Latin'Ladies, en travaillant la gestuelle et l'attitude, sur des chorégraphies modernes et des musiques latines actuelles.",
  },
  {
    name: 'Latino Kids',
    image: '/assets/danse-types/Latino Kids.png',
    description:
      "Place à la fête avec le Latino Kids : un cours plein de soleil et de sourires où les enfants découvrent les danses latines à travers des chorégraphies fun et des musiques entraînantes !",
  },
];
---

<BaseLayout title="JAMM Dance - Cours de danse à Thiais et Mandres-les-Roses" description="Association de danse latine et fitness dansant à Thiais et Mandres-les-Roses (Val-de-Marne). Cours de Zumba\u2122, Salsa, Bachata, Belly Modern et Danse Orientale pour tous les niveaux." currentPage="/">
  <!-- Hero Video Section -->
  <section class="relative h-[70vh] md:h-[85vh] overflow-hidden" aria-label="Vidéo de présentation">
    <!-- Fallback background: rich violet-tinted image visible when video is absent -->
    <img
      src="https://images.unsplash.com/photo-1547153760-18fc86c6f2b3?w=1600&q=80"
      alt=""
      class="absolute inset-0 w-full h-full object-cover opacity-30 mix-blend-overlay"
      aria-hidden="true"
    />
    <!-- Solid brand gradient backdrop ensuring text contrast without video -->
    <div class="absolute inset-0 bg-gradient-to-br from-brand-violet via-purple-900 to-brand-dark" aria-hidden="true"></div>
    <video
      autoplay
      muted
      loop
      playsinline
      class="absolute inset-0 w-full h-full object-cover z-[1]"
      poster="https://images.unsplash.com/photo-1547153760-18fc86c6f2b3?w=1600&q=80"
    >
      <source src="https://videos.pexels.com/video-files/3195397/3195397-hd_1920_1080_25fps.mp4" type="video/mp4" />
    </video>
    <!-- Violet Gradient Overlay -->
    <div class="absolute inset-0 bg-gradient-to-b from-brand-violet/60 via-brand-violet/30 to-brand-violet/70 z-[2]" aria-hidden="true"></div>

    <!-- Hero Content -->
    <div class="relative z-[3] flex flex-col items-center justify-center h-full text-center text-white px-4">
      <h1 class="mb-4 drop-shadow-lg">Bienvenue chez JAMM Dance</h1>
      <blockquote class="mb-6 max-w-xl">
        <span class="text-2xl md:text-3xl font-light italic tracking-wide text-brand-gold/90 drop-shadow-md">
          «&nbsp;Si tu sais marcher, tu sais danser&nbsp;!&nbsp;»
        </span>
      </blockquote>
      <p class="text-lg md:text-xl max-w-2xl mb-8 drop-shadow-md">
        Revêtez-vous de l'énergie des danses latines et orientales. Rejoignez notre communauté passionnée à Thiais et Mandres-les-Roses.
      </p>
      <a href="/cours" class="btn-primary shadow-xl">
        Découvrir nos cours
      </a>
    </div>
  </section>

  <!-- Dance Matrix Section -->
  <section class="section-container" aria-label="Nos styles de danse">
    <div class="text-center mb-12">
      <h2 class="text-brand-violet mb-3">Nos Styles de Danse</h2>
      <p class="text-brand-dark/70 max-w-xl mx-auto">
        Des cours pour tous les niveaux du jeune enfant aux adultes. Trouvez le style qui vous correspond.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6" role="list">
      {danceStyles.map(style => (
        <article
          role="listitem"
          data-dance-image={style.image}
          data-dance-name={style.name}
          data-dance-description={style.description}
          class="group relative overflow-hidden rounded-lg shadow-md transition-all duration-300 ease-fluid hover:shadow-xl hover:-translate-y-1 cursor-pointer"
        >
          <img src={style.image} alt={`Image représentant le style ${style.name}`} class="w-full h-64 object-cover transition-transform duration-500 ease-fluid group-hover:scale-110" loading="lazy" />
          <div class="absolute inset-0 bg-gradient-to-t from-brand-violet/90 via-brand-violet/20 to-transparent opacity-80 group-hover:opacity-100 transition-opacity duration-300 ease-fluid"></div>
          <div class="absolute bottom-0 left-0 p-5">
            <h3 class="text-white text-xl font-bold capitalize">{style.name}</h3>
            <p class="text-white/80 text-sm mt-1 opacity-0 group-hover:opacity-100 transition-opacity duration-300 ease-fluid">
              Cliquez pour en savoir plus
            </p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Dance Style Dialog -->
  <dialog id="dance-dialog" class="rounded-2xl shadow-2xl m-0 bg-white max-w-lg w-full overflow-hidden border-none p-0">
    <button aria-label="Fermer" class="absolute top-4 right-4 z-10 text-brand-violet/60 hover:text-brand-dark transition-colors duration-200 p-2 bg-white/80 rounded-full shadow-sm">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
    <div aria-hidden="true" class="w-full h-52 md:h-72 overflow-hidden">
      <img id="dialog-image" src="" alt="" class="w-full h-full object-cover" />
    </div>
    <div class="px-8 pb-8 pt-6 text-center">
      <h3 id="dialog-name" class="text-brand-violet text-2xl font-bold mb-4"></h3>
      <blockquote id="dialog-description" class="text-brand-dark/80 leading-relaxed max-w-md mx-auto"></blockquote>
      <div class="mt-6">
        <a href="/cours" class="btn-primary inline-block">
          Découvrir ce cours
        </a>
      </div>
    </div>
  </dialog>

  <script>
    const dialog = document.getElementById('dance-dialog');
    const dialogImage = document.getElementById('dialog-image');
    const dialogName = document.getElementById('dialog-name');
    const dialogDescription = document.getElementById('dialog-description');

    if (dialog && dialogImage) {
      // Open on card click
      document.querySelectorAll('[data-dance-image]').forEach(card => {
        card.addEventListener('click', () => {
          dialogImage.src = card.dataset.danceImage;
          dialogImage.alt = `Image représentant le style ${card.dataset.danceName}`;
          dialogName.textContent = card.dataset.danceName;
          dialogDescription.textContent = card.dataset.danceDescription;
          dialog.showModal();
        });
      });

      // Close on backdrop or close button click
      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) {
          dialog.close();
        }
      });

      const closeBtn = dialog.querySelector('[aria-label="Fermer"]');
      if (closeBtn) {
        closeBtn.addEventListener('click', () => {
          dialog.close();
        });
      }
    }
  </script>

  <style is:global>
    #dance-dialog::backdrop {
      background-color: rgba(26, 26, 26, 0.75);
      animation: fade-in 300ms ease-out forwards;
    }

    #dance-dialog[open] {
      position: fixed;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      margin: 0;
      animation: dialog-appear 350ms cubic-bezier(0.4, 0, 0.2, 1) forwards;
    }

    @keyframes fade-in {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    @keyframes dialog-appear {
      from {
        opacity: 0;
        transform: translate(-50%, -50%) scale(0.92);
      }
      to {
        opacity: 1;
        transform: translate(-50%, -50%) scale(1);
      }
    }
  </style>

  <!-- Upcoming Events Section -->
  <UpcomingEventsSection />

  <!-- Call to Action Section -->
  <section class="bg-brand-violet py-16 md:py-24 text-center text-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-brand-gold mb-4">Prêt à danser ?</h2>
      <p class="text-lg mb-8 text-white/90">Rejoignez JAMM Dance et découvrez une nouvelle facette de vous-même.</p>
      <a href="/cours" class="btn-primary bg-white text-brand-violet hover:bg-brand-gold hover:text-brand-dark shadow-xl">
        S'inscrire dès maintenant
      </a>
    </div>
  </section>
</BaseLayout>

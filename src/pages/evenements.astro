---
import BaseLayout from '../layouts/BaseLayout.astro';
import EventCard from '../components/EventCard.astro';
import { type Event } from '../data/events';
import eventsData from '../data/events.json';

// Type assertion for JSON import (until TypeScript resolves .json properly)
const events: Event[] = eventsData as unknown as Event[];

// Sort all events by date ascending for uniform list rendering
const sortedEvents = [...events].sort((a, b) => new Date(a.date).getTime() - new Date(b.date).getTime());
---

<BaseLayout title="Evenements" description="Consultez les evenements, stages et spectacles a venir de l'association JAMM Dance ainsi que le compte-rendu de nos evenements passes." currentPage="/evenements">
  <!-- Page Header -->
  <header class="h-[200px] md:h-[250px] bg-brand-violet flex items-center justify-center relative overflow-hidden">
    <svg class="absolute bottom-0 w-full text-brand-cream" viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0,32 C480,80 960,0 1440,32 L1440,80 L0,80 Z"></path>
    </svg>
    <h1 class="text-white relative z-10">Les Evnements</h1>
  </header>

  <!-- Featured Event Banner area - rendered client-side -->
  <!-- Placeholder filled by script with upcoming event summary -->
  <section id="events-page-banner" class="hidden bg-gradient-to-r from-brand-orange to-brand-gold py-6 md:py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <span class="text-white text-sm md:text-base font-bold uppercase tracking-wide block mb-3">
        A ne pas manquer !
      </span>
      <div id="events-page-banner-items" class="flex flex-col gap-2 sm:gap-3">
        <!-- Filled by client script -->
      </div>
    </div>
  </section>

  <!-- Events Timeline Section -->
  <section class="section-container" id="timeline">
    <div class="max-w-4xl mx-auto">
      <!-- Tabs: Upcoming / Past -->
      <div class="flex justify-center gap-6 mb-12" role="tablist" aria-label="Filtrer les evenements">
        <button
          role="tab"
          id="tab-upcoming"
          class="px-5 py-2 rounded-full text-sm font-bold border-2 transition-all duration-300 ease-fluid cursor-pointer bg-brand-orange text-white border-brand-orange"
          data-tab="upcoming"
          aria-selected="true"
        >
          A venir
        </button>
        <button
          role="tab"
          id="tab-past"
          class="px-5 py-2 rounded-full text-sm font-bold border-2 transition-all duration-300 ease-fluid cursor-pointer bg-white text-brand-violet border-brand-violet/30 hover:border-brand-violet hover:bg-brand-violet/5"
          data-tab="past"
          aria-selected="false"
        >
          Evenements passes
        </button>
      </div>

      <!-- Upcoming Events Panel -->
      <div id="upcoming-panel" class="relative" role="tabpanel" aria-labelledby="tab-upcoming">
        <div id="upcoming-empty" class="hidden text-center py-12 text-brand-dark/50">
          <p class="text-lg mb-2">Aucun evenement a venir pour le moment.</p>
          <p class="text-sm">Retrouvez ici tous nos stages et soirees !</p>
        </div>

        <!-- Timeline vertical line -->
        <div id="upcoming-timeline-line" class="absolute left-[15px] md:left-8 top-0 bottom-0 w-0.5 bg-gradient-to-b from-brand-violet to-brand-orange" aria-hidden="true"></div>

        <div id="upcoming-events-container" class="space-y-8">
          {sortedEvents.map((event: Event, index: number) => (
            <article
              data-event-date={event.date}
              id={`upcoming-item-${index}`}
              data-is-listed="false"
              class="hidden relative flex gap-6"
            >
              <!-- Timeline Anchor Dot -->
              <div class="absolute left-[7px] md:left-[23px] w-8 h-8 rounded-full bg-brand-violet border-4 border-white shadow flex items-center justify-center flex-shrink-0 z-10" aria-hidden="true">
                <span class="event-index-dot text-xs font-bold text-white"></span>
              </div>

              <!-- Event Card -->
              <div class="ml-[51px] md:ml-20 w-full">
                <EventCard event={event} />
              </div>
            </article>
          ))}
        </div>
      </div>

      <!-- Past Events Panel (hidden by default) -->
      <div id="past-panel" class="relative hidden" role="tabpanel" aria-labelledby="tab-past">
        <div id="past-empty" class="hidden text-center py-12 text-brand-dark/50">
          <p class="text-lg mb-2">Aucun evenement passe enregistre.</p>
        </div>

        <!-- Timeline vertical line (muted for past) -->
        <div id="past-timeline-line" class="absolute left-[15px] md:left-8 top-0 bottom-0 w-0.5 bg-gray-300" aria-hidden="true"></div>

        <div id="past-events-container" class="space-y-8">
          {sortedEvents.map((event: Event, index: number) => (
            <article
              data-event-date={event.date}
              id={`past-item-${index}`}
              data-is-listed="false"
              class="hidden relative flex gap-6"
            >
              <!-- Timeline Anchor Dot -->
              <div class="absolute left-[7px] md:left-[23px] w-8 h-8 rounded-full bg-gray-400 border-4 border-white shadow flex items-center justify-center flex-shrink-0 z-10" aria-hidden="true">
                <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </div>

              <!-- Event Card -->
              <div class="ml-[51px] md:ml-20 w-full">
                <EventCard event={event} isPast={true} />
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Client-side logic: date filtering + tab toggle -->
  <script is:inline>
  (function () {
    var today = new Date();
    today.setHours(0, 0, 0, 0);

    // Gather all event items from both panels
    var upcomingItems = document.querySelectorAll('#upcoming-events-container [data-event-date]');
    var pastItems = document.querySelectorAll('#past-events-container [data-event-date]');

    var hasUpcoming = false;
    var hasPast = false;
    var upcomingForBanner = [];

    // Classify into upcoming vs past, reveal the right copies
    upcomingItems.forEach(function (item) {
      var eventDate = new Date(item.dataset.eventDate);
      if (eventDate >= today) {
        item.classList.remove('hidden');
        item.dataset.isListed = 'true';
        hasUpcoming = true;
        upcomingForBanner.push({
          displayDate: item.querySelector('time').textContent,
          title: item.querySelector('.event-card h2, .event-card h3').textContent
        });
      } else {
        // If it's past, hide the upcoming copy (already hidden by default)
      }
    });

    pastItems.forEach(function (item) {
      var eventDate = new Date(item.dataset.eventDate);
      if (eventDate < today) {
        item.classList.remove('hidden');
        item.dataset.isListed = 'true';
        hasPast = true;
      } else {
        // If it's upcoming, hide the past copy (already hidden by default)
      }
    });

    // Reindex upcoming timeline dots sequentially
    var visibleUpcoming = document.querySelectorAll('#upcoming-events-container [data-event-date][class]:not(.hidden)');
    var counter = 1;
    visibleUpcoming.forEach(function (item) {
      var dotSpan = item.querySelector('.event-index-dot');
      if (dotSpan) dotSpan.textContent = counter++;
    });

    // Show / hide empty states
    if (!hasUpcoming) {
      document.getElementById('upcoming-empty')?.classList.remove('hidden');
      document.getElementById('upcoming-timeline-line')?.classList.add('hidden');
      document.getElementById('upcoming-events-container')?.classList.add('hidden');
    }

    if (!hasPast) {
      document.getElementById('past-empty')?.classList.remove('hidden');
      document.getElementById('past-timeline-line')?.classList.add('hidden');
      document.getElementById('past-events-container')?.classList.add('hidden');
    }

    // Build the top banner items (upcoming events summary strip)
    if (hasUpcoming && upcomingForBanner.length > 0) {
      var bannerSection = document.getElementById('events-page-banner');
      var bannerContainer = document.getElementById('events-page-banner-items');
      upcomingForBanner.forEach(function (ev) {
        var row = document.createElement('div');
        row.className = 'flex items-start gap-2 sm:gap-3';

        var timeEl = document.createElement('time');
        timeEl.className = 'text-white/90 text-[11px] sm:text-sm font-medium flex-shrink-0 mt-0.5';
        timeEl.textContent = ev.displayDate;

        var dot = document.createElement('span');
        dot.className = 'w-1 h-1 rounded-full bg-white/60 flex-shrink-0 mt-1.5 hidden sm:inline-block';
        dot.setAttribute('aria-hidden', 'true');

        var titleEl = document.createElement('p');
        titleEl.className = 'text-white font-bold text-xs sm:text-base break-words';
        titleEl.textContent = ev.title;

        row.appendChild(timeEl);
        row.appendChild(dot);
        row.appendChild(titleEl);
        bannerContainer.appendChild(row);
      });
      bannerSection.classList.remove('hidden');
    }

    // Tab toggle logic
    var tabs = document.querySelectorAll('[data-tab]');
    var upcomingPanel = document.getElementById('upcoming-panel');
    var pastPanel = document.getElementById('past-panel');

    tabs.forEach(function (tab) {
      tab.addEventListener('click', function () {
        var target = tab.dataset.tab;

        tabs.forEach(function (t) {
          t.classList.remove('bg-brand-orange', 'text-white', 'border-brand-orange');
          t.classList.add('bg-white', 'text-brand-violet', 'border-brand-violet/30');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('bg-brand-orange', 'text-white', 'border-brand-orange');
        tab.classList.remove('bg-white', 'text-brand-violet', 'border-brand-violet/30');
        tab.setAttribute('aria-selected', 'true');

        if (target === 'upcoming') {
          upcomingPanel?.classList.remove('hidden');
          pastPanel?.classList.add('hidden');
        } else {
          upcomingPanel?.classList.add('hidden');
          pastPanel?.classList.remove('hidden');
        }
      });
    });
  })();
  </script>

  <!-- CTA Section -->
  <section class="bg-brand-violet py-16 md:py-24 text-center text-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-brand-gold mb-4">Ne manquez aucun evenement !</h2>
      <p class="text-lg mb-8 text-white/90">Restez connecte pour recevoir les annonces de stages et spectacles en exclusivite.</p>
      <a href="/inscriptions" class="btn-primary bg-white text-brand-violet hover:bg-brand-gold hover:text-brand-dark shadow-xl">
        S'inscrire aux cours
      </a>
    </div>
  </section>
</BaseLayout>
